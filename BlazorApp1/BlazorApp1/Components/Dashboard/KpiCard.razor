<div class="card border-0 shadow-sm p-3 d-flex flex-row justify-content-between align-items-center h-100">
    <div>
        <div class="text-secondary small">@Titulo</div>
        <div class="h4 mb-0 fw-bold">@Valor</div>
    </div>
    <span class="badge px-2 py-1 @ClaseTrend">@TrendTexto</span>
</div>

@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public string TrendTexto { get; set; } = "";
    [Parameter] public bool EsPositivo { get; set; } = true;

    // Verde si es positivo, rojo si es negativo
    private string ClaseTrend => EsPositivo
        ? "bg-success-subtle text-success border border-success-subtle"
        : "bg-danger-subtle text-danger border border-danger-subtle";
}
