<div class="card h-100 border-0 shadow-sm">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge @(Curso.Estado == "Activo" ? "bg-success" : "bg-warning text-dark")">
                @Curso.Estado
            </span>
            <small class="text-body-tertiary font-monospace">@Curso.Codigo</small>
        </div>

        <h5 class="card-title h6 fw-bold">@Curso.Nombre</h5>
        <p class="card-text text-secondary small flex-grow-1">@Curso.Descripcion</p>

        @if (!string.IsNullOrEmpty(Curso.NombreTemario))
        {
            <div class="small text-primary mb-1">📄 Temario: @Curso.NombreTemario</div>
        }

        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-3">
            <small class="text-body-secondary">@Curso.Matriculados alumnos</small>
            <small class="fw-semibold">@Curso.PrecioXAlumno.ToString("N2") €</small>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="() => OnAlternarEstado.InvokeAsync(Curso.Codigo)">
                Estado
            </button>
            <button class="btn btn-outline-primary btn-sm"
                    @onclick="() => OnCopiarCodigo.InvokeAsync(Curso.Codigo)">
                Copiar
            </button>
            <button class="btn btn-outline-danger btn-sm ms-auto"
                    @onclick="() => OnEliminar.InvokeAsync(Curso.Codigo)">
                Eliminar
            </button>
        </div>
    </div>
</div>

@code {
    // Dato que recibe del padre
    [Parameter, EditorRequired] public CursoEntity Curso { get; set; } = default!;

    // Eventos que envía al padre (le pasa el código del curso)
    [Parameter] public EventCallback<string> OnAlternarEstado { get; set; }
    [Parameter] public EventCallback<string> OnEliminar { get; set; }
    [Parameter] public EventCallback<string> OnCopiarCodigo { get; set; }
}
