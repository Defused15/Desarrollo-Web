@page "/dashboard"
@implements IDisposable
@inject IJSRuntime JS
@inject ToastService ToastService
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid bg-light min-vh-100 p-4">

    <!-- 1. Header -->
    <header class="d-flex justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm mb-4">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-4">📊</span>
            <h2 class="h5 mb-0 fw-bold">TechMetrics Blazor</h2>
        </div>
        <div class="d-flex align-items-center gap-3">
            <!-- Estado de la red, lo avisa JavaScript -->
            <span class="badge @(enLinea ? "bg-success" : "bg-danger")">
                @(enLinea ? "En línea" : "Sin conexión")
            </span>
            <div class="text-end">
                <div class="fw-semibold small">Usuario</div>
                <div class="text-secondary" style="font-size: 0.75rem;">Descripción</div>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(alertaPagina))
    {
        <div class="alert alert-warning alert-dismissible py-2">
            @alertaPagina
            <button type="button" class="btn-close" @onclick="() => alertaPagina = null"></button>
        </div>
    }

    <!-- 2. KPIs calculados con LINQ -->
    <section class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <KpiCard Titulo="Total Alumnos"
                     Valor="@TotalAlumnos.ToString()"
                     TrendTexto="+8%"
                     EsPositivo="true" />
        </div>
        <div class="col-12 col-md-4">
            <KpiCard Titulo="Activos / En Revisión"
                     Valor="@($"{CursosActivos} / {CursosEnRevision}")"
                     TrendTexto="@(CursosEnRevision == 0 ? "Todo OK" : $"{CursosEnRevision} pendientes")"
                     EsPositivo="@(CursosEnRevision == 0)" />
        </div>
        <div class="col-12 col-md-4">
            <KpiCard Titulo="Ingresos Estimados"
                     Valor="@($"€ {IngresosEstimados:N0}")"
                     TrendTexto="+14%"
                     EsPositivo="true" />
        </div>
    </section>

    <!-- Gráficos (BlazorBootstrap + Chart.js) -->
    <section class="row g-3 mb-4">
        <div class="col-12 col-lg-7">
            <div class="card p-3 shadow-sm border-0 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">Distribución de Matriculados por Curso</h6>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Analítica C#</span>
                </div>
                <BarChart @ref="barChart" Height="220" />
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="card p-3 shadow-sm border-0 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">Ingresos por Curso</h6>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">€</span>
                </div>
                <PieChart @ref="pieChart" Height="220" />
            </div>
        </div>
    </section>

    <!-- 3. Catálogo de cursos -->
    <main>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h3 class="h5 mb-0 fw-bold">Cursos del Semestre</h3>
            <button class="btn btn-primary btn-sm px-3 shadow-sm" @onclick="AbrirModal">
                + Nuevo Curso
            </button>
        </div>

        <!-- Búsqueda y filtro -->
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-8">
                <input class="form-control" placeholder="Buscar por nombre o código..."
                       @bind="TextoBusqueda" @bind:event="oninput" />
            </div>
            <div class="col-12 col-md-4">
                <select class="form-select" @bind="FiltroEstado">
                    <option value="Todos">Todos</option>
                    <option value="Activo">Activo</option>
                    <option value="En Revisión">En Revisión</option>
                </select>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var curso in CursosFiltrados)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <CursoCard Curso="curso"
                               OnAlternarEstado="AlternarEstado"
                               OnEliminar="EliminarCurso"
                               OnCopiarCodigo="CopiarCodigo" />
                </div>
            }
        </div>

        @if (!CursosFiltrados.Any())
        {
            <p class="text-secondary mt-3">No hay cursos que coincidan con la búsqueda.</p>
        }
    </main>

    <!-- 4. Modal de BlazorBootstrap para nuevo curso -->
    <Modal @ref="modalRef" Title="Añadir Nuevo Curso" IsVerticallyCentered="true">
        <BodyTemplate>
            @if (!string.IsNullOrEmpty(errorFormulario))
            {
                <div class="alert alert-danger py-2">@errorFormulario</div>
            }
            <div class="mb-3">
                <label class="form-label small fw-semibold">Código</label>
                <input type="text" class="form-control" placeholder="Ej: DWM-105"
                       @bind="nuevoCurso.Codigo" />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Nombre del Curso</label>
                <input type="text" class="form-control" placeholder="Ej: Diseño de Interfaces"
                       @bind="nuevoCurso.Nombre" />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Descripción</label>
                <textarea class="form-control" rows="2" placeholder="Breve descripción del curso..."
                          @bind="nuevoCurso.Descripcion"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label small fw-semibold">Matriculados</label>
                    <input type="number" class="form-control" @bind="nuevoCurso.Matriculados" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label small fw-semibold">Precio por Alumno (€)</label>
                    <input type="number" step="0.01" class="form-control" @bind="nuevoCurso.PrecioXAlumno" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Estado</label>
                <select class="form-select" @bind="nuevoCurso.Estado">
                    <option value="Activo">Activo</option>
                    <option value="En Revisión">En Revisión</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Temario del curso</label>
                <InputFile class="form-control" OnChange="ProcesarTemario" accept=".pdf,.doc,.docx" />
                @if (!string.IsNullOrEmpty(nombreTemario))
                {
                    <div class="form-text">Adjunto: @nombreTemario</div>
                }
            </div>
        </BodyTemplate>
        <FooterTemplate>
            <Button Color="ButtonColor.Secondary" @onclick="CerrarModal">Cancelar</Button>
            <Button Color="ButtonColor.Primary" @onclick="GuardarCurso">Guardar Curso</Button>
        </FooterTemplate>
    </Modal>
</div>

@code {
    // ===== Datos (vienen de SQLite) =====
    private List<CursoEntity> Cursos = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarCursosAsync();
    }

    private async Task CargarCursosAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        Cursos = await db.Cursos
            .AsNoTracking()
            .OrderByDescending(c => c.Id)
            .ToListAsync();

        // Sincronizar los gráficos con los datos frescos de SQLite
        if (graficosListos)
            await ActualizarGraficosAsync();
    }

    // ===== Búsqueda y filtro (LINQ) =====
    private string TextoBusqueda = "";
    private string FiltroEstado = "Todos";

    private IEnumerable<CursoEntity> CursosFiltrados => Cursos
        .Where(c => FiltroEstado == "Todos" || c.Estado == FiltroEstado)
        .Where(c => string.IsNullOrWhiteSpace(TextoBusqueda)
                 || c.Nombre.Contains(TextoBusqueda, StringComparison.OrdinalIgnoreCase)
                 || c.Codigo.Contains(TextoBusqueda, StringComparison.OrdinalIgnoreCase));

    // ===== KPIs en tiempo real (LINQ) =====
    private int TotalAlumnos => Cursos.Sum(c => c.Matriculados);
    private int CursosActivos => Cursos.Count(c => c.Estado == "Activo");
    private int CursosEnRevision => Cursos.Count(c => c.Estado == "En Revisión");
    private decimal IngresosEstimados => Cursos.Sum(c => c.Matriculados * c.PrecioXAlumno);

    // ===== Formulario del modal =====
    private class CursoFormulario
    {
        public string Codigo { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public int Matriculados { get; set; } = 0;
        public decimal PrecioXAlumno { get; set; } = 0m;
        public string Estado { get; set; } = "Activo";
    }

    private CursoFormulario nuevoCurso = new();
    private string? errorFormulario;

    // ===== Modal de BlazorBootstrap =====
    private Modal modalRef = default!;
    private string? nombreTemario;

    private async Task AbrirModal()
    {
        nuevoCurso = new();
        nombreTemario = null;
        errorFormulario = null;
        await modalRef.ShowAsync();
    }

    private async Task CerrarModal() => await modalRef.HideAsync();

    private void ProcesarTemario(InputFileChangeEventArgs e)
    {
        nombreTemario = e.File.Name;
        ToastService.Notify(new(ToastType.Info, "Temario Adjuntado", $"Archivo: {nombreTemario}"));
    }

    private string? alertaPagina;

    // Alta con control de duplicados
    private async Task GuardarCurso()
    {
        if (string.IsNullOrWhiteSpace(nuevoCurso.Codigo) || string.IsNullOrWhiteSpace(nuevoCurso.Nombre))
        {
            errorFormulario = "El código y el nombre son obligatorios.";
            return;
        }

        var entidad = new CursoEntity
        {
            Codigo = nuevoCurso.Codigo.Trim(),
            Nombre = nuevoCurso.Nombre.Trim(),
            Descripcion = nuevoCurso.Descripcion.Trim(),
            Matriculados = nuevoCurso.Matriculados,
            PrecioXAlumno = nuevoCurso.PrecioXAlumno,
            Estado = nuevoCurso.Estado,
            NombreTemario = nombreTemario
        };

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            db.Cursos.Add(entidad);
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            // El índice único de Codigo no deja guardar un código repetido
            await modalRef.HideAsync();
            alertaPagina = $"No se ha guardado: ya existe un curso con el código {entidad.Codigo}.";
            return;
        }

        await modalRef.HideAsync();
        ToastService.Notify(new(ToastType.Success, "¡Curso Creado con Éxito!",
            $"Se ha incorporado '{entidad.Nombre}' al catálogo."));

        // Reiniciar formulario
        nuevoCurso = new();
        nombreTemario = null;

        await CargarCursosAsync();
    }

    // ===== Eventos que llegan desde CursoCard =====

    // Modificación: Activo <-> En Revisión
    private async Task AlternarEstado(string codigo)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var curso = await db.Cursos.FirstOrDefaultAsync(c => c.Codigo == codigo);
        if (curso == null) return;

        curso.Estado = curso.Estado == "Activo" ? "En Revisión" : "Activo";
        await db.SaveChangesAsync();

        ToastService.Notify(new(ToastType.Info, "Estado actualizado", $"{codigo} ahora está '{curso.Estado}'."));
        await CargarCursosAsync();
    }

    // Borrado
    private async Task EliminarCurso(string codigo)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var curso = await db.Cursos.FirstOrDefaultAsync(c => c.Codigo == codigo);
        if (curso == null) return;

        db.Cursos.Remove(curso);
        await db.SaveChangesAsync();

        ToastService.Notify(new(ToastType.Danger, "Curso eliminado", $"Se ha eliminado {codigo}."));
        await CargarCursosAsync();
    }

    // ===== Gráficos (BlazorBootstrap) =====
    private BarChart barChart = default!;
    private PieChart pieChart = default!;

    private static readonly List<string> Colores = new()
    {
        "#2563eb", "#16a34a", "#f59e0b", "#dc2626", "#7c3aed", "#0891b2", "#db2777", "#65a30d"
    };

    private ChartData DatosBarras() => new()
    {
        Labels = Cursos.Select(c => c.Codigo).ToList(),
        Datasets = new List<IChartDataset>
        {
            new BarChartDataset
            {
                Label = "Matriculados",
                Data = Cursos.Select(c => (double?)c.Matriculados).ToList(),
                BackgroundColor = Cursos.Select((c, i) => Colores[i % Colores.Count]).ToList(),
                BorderWidth = new List<double> { 0 }
            }
        }
    };

    private ChartData DatosTarta() => new()
    {
        Labels = Cursos.Select(c => c.Codigo).ToList(),
        Datasets = new List<IChartDataset>
        {
            new PieChartDataset
            {
                Label = "Ingresos (€)",
                Data = Cursos.Select(c => (double?)(c.Matriculados * c.PrecioXAlumno)).ToList(),
                BackgroundColor = Cursos.Select((c, i) => Colores[i % Colores.Count]).ToList()
            }
        }
    };

    private BarChartOptions OpcionesBarras() => new()
    {
        Responsive = true,
        Plugins = new BarChartPlugins { Legend = new ChartPluginsLegend { Display = false } }
    };

    private PieChartOptions OpcionesTarta() => new() { Responsive = true };

    private bool graficosListos;

    private async Task InicializarGraficosAsync()
    {
        await barChart.InitializeAsync(DatosBarras(), OpcionesBarras());
        await pieChart.InitializeAsync(DatosTarta(), OpcionesTarta());
        graficosListos = true;
    }

    private async Task ActualizarGraficosAsync()
    {
        await barChart.UpdateAsync(DatosBarras(), OpcionesBarras());
        await pieChart.UpdateAsync(DatosTarta(), OpcionesTarta());
    }

    // ===== JavaScript Interop =====
    private bool enLinea = true;
    private DotNetObjectReference<Dashboard>? referenciaDotNet;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 1. Dibujar los gráficos (los datos ya vienen de SQLite)
        await InicializarGraficosAsync();

        // 2. Pasar a JS una referencia a este componente para que nos avise de la red
        referenciaDotNet = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("dashboardInterop.iniciarMonitorRed", referenciaDotNet);
    }

    // Lo llama JavaScript cuando cambia la conexión
    [JSInvokable]
    public Task OnCambioEstadoRed(bool estaEnLinea)
    {
        enLinea = estaEnLinea;
        return InvokeAsync(StateHasChanged);
    }

    private async Task CopiarCodigo(string codigo)
    {
        var curso = Cursos.FirstOrDefault(c => c.Codigo == codigo);
        if (curso == null) return;

        var texto = $"{curso.Codigo} - {curso.Nombre} ({curso.Matriculados} alumnos, {curso.PrecioXAlumno:N2} €)";
        var ok = await JS.InvokeAsync<bool>("dashboardInterop.copiarPortapapeles", texto);

        if (ok)
            ToastService.Notify(new(ToastType.Success, "Copiado", texto));
        else
            ToastService.Notify(new(ToastType.Warning, "Error", "No se pudo copiar al portapapeles."));
    }

    public void Dispose()
    {
        referenciaDotNet?.Dispose();
    }
}
